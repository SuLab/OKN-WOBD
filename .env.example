# OKN-WOBD Environment Configuration
#
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
#
# The .env file is gitignored and will not be committed.

# ---------------------------------------------------------------------------
# API Keys
# ---------------------------------------------------------------------------

# Anthropic API key (for LLM summaries in ChatGEO, go_disease_analysis, NL-to-SPARQL)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Anthropic model for LLM tasks (interpretation, NL-to-SPARQL, summaries)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI API key (alternative to Anthropic for NL-to-SPARQL)
# OPENAI_API_KEY=your-openai-key-here

# ---------------------------------------------------------------------------
# Data Paths
# ---------------------------------------------------------------------------

# Path to directory containing ARCHS4 HDF5 files (human_gene_v2.latest.h5, etc.)
# These files are large (~58GB each) and should be stored outside the repository.
# Download via: archs4py.download.counts("human", path=ARCHS4_DATA_DIR)
# ARCHS4_DATA_DIR=/path/to/archs4

# ---------------------------------------------------------------------------
# MCP Server (okn-wobd-mcp)
# ---------------------------------------------------------------------------

# Transport: stdio (default, for Claude Code), streamable-http, or sse
# OKN_MCP_TRANSPORT=stdio

# Host and port for HTTP/SSE transports
# OKN_MCP_HOST=0.0.0.0
# OKN_MCP_PORT=8000

# API key for authenticating remote MCP clients (optional, HTTP/SSE only)
# OKN_MCP_API_KEY=

# Log level and file location
# OKN_MCP_LOG_LEVEL=INFO
# OKN_MCP_LOG_FILE=~/.okn_wobd/mcp_server.log

# ---------------------------------------------------------------------------
# ChatGEO Options
# ---------------------------------------------------------------------------

# Set to 0 to disable ontology-based sample discovery (keyword search only)
# CHATGEO_ONTOLOGY_SEARCH=1
